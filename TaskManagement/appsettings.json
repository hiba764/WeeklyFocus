{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    // سلسلة الاتصال بقاعدة البيانات (SQLite)
    // SQLite هي قاعدة بيانات خفيفة تعمل كملف واحد، لا تحتاج إلى خادم منفصل
    "ConnectionStrings": {
        // "DefaultConnection" هو اسم هذا الإعداد، سنستخدمه في Program.cs
        // Data Source=weeklyfocus.db: يعني أن قاعدة البيانات ستُخزّن في ملف باسم weeklyfocus.db داخل مجلد المشروع
        "DefaultConnection": "Data Source=weeklyfocus.db"
    },
    "AllowedHosts": "*"
}